---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const it = lang === 'it';
const q = it ? '' : '?lang=en';
const code = `<iframe src="${SITE_URL}/embed/simulatore-fotovoltaico/${q}" title="${it ? 'Simulatore fotovoltaico' : 'Solar calculator'}" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Italian Solar Calculator on Your Site for Free" description="Embed the 2026 Italian solar calculator by comune for free with an iframe: copy the code, no account, no cookies, GSE and ARERA prices update themselves automatically." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: it ? 'Inizio' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{it ? 'Inserire il simulatore fotovoltaico' : 'Embed the solar calculator'}</h1>
    <p class="mt-3 text-lg text-navy-700">{it ? 'Per comuni, sportelli energia, associazioni e redazioni locali: si copia una volta, prezzi e aliquote si aggiornano da soli.' : 'For municipalities, energy desks, associations and local newsrooms: copy once, prices and rates update themselves.'}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>{it ? 'Codice da copiare' : 'Code to copy'}</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{it ? 'Condizioni: il link alla fonte sotto il simulatore resta visibile, il simulatore non viene modificato ed è fornito senza garanzia. Ciò che scrivono i vostri lettori resta sul loro dispositivo; il riquadro non deposita cookie e non misura nulla.' : 'Terms: the source link under the calculator stays visible, the calculator is not modified, and it is provided without warranty. What your readers type stays on their device; the frame sets no cookies and measures nothing.'} <a href={route('contact', lang)}>{it ? 'Domande' : 'Questions'}</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/simulatore-fotovoltaico/${q}`} title={it ? 'Simulatore fotovoltaico' : 'Solar calculator'} width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
