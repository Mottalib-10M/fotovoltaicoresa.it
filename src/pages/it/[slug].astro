---
/** Pagine di calcolo, guide e città (it): un file in src/content/ = una pagina (CONTRIBUTING-PAGINE.md). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.it.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="it" />
